# ===== Development Stage =====
FROM node:24-alpine AS dev
WORKDIR /app

# Install global tools
RUN npm install -g nodemon

# Frontend setup
WORKDIR /app/frontend
COPY frontend/package.json .
RUN npm install --include=dev  # Explicitly install devDependencies
COPY frontend .

# Backend setup
WORKDIR /app/backend
COPY backend/package.json .
RUN npm install
COPY backend .

WORKDIR /app
CMD ["sh", "-c", "cd frontend && npm run dev & cd backend && npm run dev"]

# ===== Frontend Builder =====
FROM node:24-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package.json .
RUN npm install  # Installs both dependencies and devDependencies
COPY frontend .
RUN npm run build

# ===== Backend Builder =====
FROM node:24-alpine AS backend-builder
WORKDIR /app/backend
COPY backend/package.json .
RUN npm install
COPY backend .

# ===== Production Image =====
FROM node:24-alpine
WORKDIR /app
COPY --from=backend-builder /app/backend ./backend
COPY --from=frontend-builder /app/frontend/dist ./public
EXPOSE 5000
CMD ["node", "backend/index.js"]